---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { SITE } from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("blog");
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(posts, tag);

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: SITE.postPerPage,
    });
  });
}

const params = Astro.params;
const { tag } = params as { tag: string };
const { page, tagName } = Astro.props;
---

<Layout
  title={
    page.currentPage > 1
      ? `标签：${tagName} · 第${page.currentPage}页 | ${SITE.title}`
      : `标签：${tagName} | ${SITE.title}`
  }
  description={`「${tagName}」标签下的全部文章（共 ${page.total} 篇）｜Sing-box 教程指南的${tagName}相关教程与实战。`}
  schemaType="CollectionPage"
  noindex={page.currentPage > 1}
>
  <Header />
  <Main
    pageTitle={[`标签：`, `${tagName}`]}
    titleTransition={tag}
    pageDesc={`所有含有“${tagName}”标签的文章。`}
  >
    <h1 slot="title" transition:name={tag}>{`标签：${tagName}`}</h1>
    <ul>
      {page.data.map((data: any) => <Card {...data} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
