---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";
import IntroAudio from "@/components/IntroAudio.astro";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts
  .filter(({ data }) => data.featured)
  .slice(0, 4);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />

  <main id="main-content" data-layout="index" class="relative app-layout">
    <!-- Ambient Background Glow -->
    <div
      class="pointer-events-none absolute -top-10 left-1/2 -z-10 h-96 w-full max-w-4xl -translate-x-1/2 rounded-full bg-gradient-to-tr from-accent/20 via-accent/10 to-transparent opacity-60 blur-3xl"
    >
    </div>

    <!-- ═══════════════════ HERO ═══════════════════ -->
    <section
      id="hero"
      class="hero-section relative pt-10 pb-14 sm:pt-14 sm:pb-20"
    >
      <div class="relative z-10">
        <!-- Terminal prompt badge -->
        <div
          class="mb-4 inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-4 py-1.5 font-cartograph text-xs shadow-sm backdrop-blur-md sm:text-sm"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"
            ></span>
          </span>
          <span class="font-semibold text-accent">~</span>/sing-box-guide <span
            class="opacity-40">$</span
          >
        </div>

        <!-- Title -->
        <h1
          class="hero-title mb-4 text-5xl leading-[1.1] font-extrabold tracking-tight sm:text-6xl lg:text-7xl"
        >
          {SITE.title}
          <a
            target="_blank"
            rel="noopener noreferrer nofollow"
            href="/rss.xml"
            class="ml-2 inline-block align-middle"
            aria-label="rss feed"
            title="RSS Feed"
          >
            <IconRss
              width={24}
              height={24}
              class="stroke-accent stroke-3 opacity-60 transition-all duration-300 hover:scale-110 hover:opacity-100"
            />
            <span class="sr-only">RSS Feed</span>
          </a>
        </h1>

        {/* ── Audio de marca ── */}
        {
          SITE.introAudio.enabled && (
            <div class="mt-3">
              <IntroAudio
                src={SITE.introAudio.src}
                label={SITE.introAudio.label}
                duration={SITE.introAudio.duration}
              />
            </div>
          )
        }

        <!-- Description -->
        <p
          class="mt-6 max-w-2xl text-base leading-relaxed font-normal opacity-85 sm:text-xl"
        >
          探索前沿加密协议，构筑极速零泄露的网络环境。一本专注 Sing-box
          的全平台使用指南与高级规则架构实战手册。
        </p>

        <!-- Feature Pills -->
        <div class="mt-6 flex flex-wrap gap-2 text-xs font-medium sm:text-sm">
          <span
            class="inline-flex items-center gap-1.5 rounded-lg border border-border/40 bg-background/60 px-3 py-1.5 shadow-xs backdrop-blur-xs"
          >
            ⚡ 2026 最新 Sing-box 标准
          </span>
          <span
            class="inline-flex items-center gap-1.5 rounded-lg border border-border/40 bg-background/60 px-3 py-1.5 shadow-xs backdrop-blur-xs"
          >
            🛡️ 零泄露 DNS & 反主动探测
          </span>
          <span
            class="inline-flex items-center gap-1.5 rounded-lg border border-border/40 bg-background/60 px-3 py-1.5 shadow-xs backdrop-blur-xs"
          >
            🚀 Hysteria 2 / VLESS-Reality
          </span>
          <span
            class="inline-flex items-center gap-1.5 rounded-lg border border-border/40 bg-background/60 px-3 py-1.5 shadow-xs backdrop-blur-xs"
          >
            📱 全平台客户端配置指南
          </span>
        </div>

        <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
          <p class="flex-shrink-0 text-sm opacity-60">
            作者：
            <LinkButton
              class="font-semibold underline decoration-dashed underline-offset-4 hover:text-accent"
              href={SITE.profile}
              target="_blank"
              rel="noopener noreferrer nofollow"
            >
              {SITE.author}
            </LinkButton>
          </p>

          {
            // only display if at least one social link is enabled
            SOCIALS.length > 0 && (
              <div class="border-border/40 sm:border-l sm:pl-4">
                <Socials />
              </div>
            )
          }
        </div>
      </div>
    </section>

    <!-- ═══════════════════ FEATURED ═══════════════════ -->
    {
      featuredPosts.length > 0 && (
        <section id="featured" class="pb-8">
          <div class="mb-6 flex items-center gap-3">
            <h2 class="flex items-center gap-2 text-sm font-bold tracking-widest text-accent uppercase">
              <svg
                class="size-4"
                fill="currentColor"
                viewBox="0 0 20 20"
                aria-hidden="true"
              >
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
              精选推荐
            </h2>
            <div class="h-px flex-1 bg-border/20" />
          </div>

          <ul class="grid gap-4 sm:grid-cols-2 [&>li]:my-0">
            {featuredPosts.map(data => (
              <Card variant="h3" featured={true} {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <!-- ═══════════════════ RECENT POSTS ═══════════════════ -->
    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-6 pb-8">
          <div class="mb-6 flex items-center gap-3">
            <h2 class="text-sm font-bold tracking-widest uppercase opacity-80">
              最新发布
            </h2>
            <div class="h-px flex-1 bg-border/20" />
            <span class="font-cartograph text-xs text-accent/60 select-none">
              [{recentPosts.slice(0, SITE.postPerIndex).length}/
              {recentPosts.length}]
            </span>
          </div>
          <ul class="grid gap-2">
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>

          {/* ═══════════════════ CTA ═══════════════════ */}
          <div class="mt-10 mb-4 flex w-full justify-center">
            <LinkButton
              href="/posts/"
              class="group inline-flex w-full items-center justify-center gap-2 rounded-xl border border-accent/30 bg-accent/10 px-8 py-4 text-base font-bold text-accent backdrop-blur-xs transition-all duration-300 hover:-translate-y-0.5 hover:border-accent hover:bg-accent/20 hover:shadow-xl hover:shadow-accent/20 sm:w-auto"
            >
              浏览所有文章
              <IconArrowRight class="inline-block transition-transform duration-300 group-hover:translate-x-1 rtl:-rotate-180" />
            </LinkButton>
          </div>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>

<style>
  /* ── Hero title shimmer ── */
  .hero-title {
    background: linear-gradient(
      135deg,
      var(--accent) 0%,
      color-mix(in oklab, var(--accent) 60%, var(--foreground)) 25%,
      var(--foreground) 40%,
      var(--foreground) 60%,
      color-mix(in oklab, var(--accent) 60%, var(--foreground)) 75%,
      var(--accent) 100%
    );
    background-size: 250% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shimmer 6s ease-in-out infinite;
  }

  @keyframes shimmer {
    0%,
    100% {
      background-position: 0% center;
    }
    50% {
      background-position: 100% center;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }

    // ── Card glow follow cursor ──
    document.querySelectorAll<HTMLElement>(".card-glow").forEach(card => {
      card.addEventListener("mousemove", (e: MouseEvent) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty("--mouse-x", `${e.clientX - rect.left}px`);
        card.style.setProperty("--mouse-y", `${e.clientY - rect.top}px`);
      });
    });
  });
</script>
