---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
  featured?: boolean;
} & CollectionEntry<"blog">;

const {
  variant: Heading = "h2",
  featured = false,
  id,
  data,
  filePath,
} = Astro.props;

const { title, description, tags, ...props } = data;
---

<li
  class:list={[
    "card-glow group/card relative my-3.5 rounded-2xl p-5 sm:p-6",
    "border border-border/30 bg-background/40 backdrop-blur-sm",
    "transition-all duration-300 ease-out",
    "hover:border-accent/50 hover:bg-accent/[0.04]",
    "hover:-translate-y-1",
    "hover:shadow-xl hover:shadow-accent/10",
    featured &&
      "border-accent/40 bg-accent/[0.06] shadow-[0_0_25px_-5px_rgba(var(--accent),0.2)]",
  ]}
>
  <!-- Cursor-following glow -->
  <div
    class="card-glow-effect pointer-events-none absolute inset-0 z-0 rounded-2xl opacity-0 transition-opacity duration-300 group-hover/card:opacity-100"
    aria-hidden="true"
  >
  </div>
  <!-- Noise dithering -->
  <div
    class="card-noise pointer-events-none absolute inset-0 z-1 rounded-2xl opacity-0 transition-opacity duration-300 group-hover/card:opacity-100"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-5 flex h-full flex-col justify-between">
    <div>
      <div class="mb-2 flex items-center justify-between gap-2">
        <Datetime
          pubDatetime={props.pubDatetime as string | Date}
          modDatetime={props.modDatetime as string | Date | null | undefined}
          class="pointer-events-none relative z-20 text-xs opacity-75"
        />

        {
          tags && tags.length > 0 && (
            <span class="inline-flex items-center rounded-md border border-accent/20 bg-accent/10 px-2 py-0.5 font-cartograph text-[11px] font-medium text-accent">
              #{tags[0]}
            </span>
          )
        }
      </div>

      <a
        href={getPath(id, filePath)}
        class="rounded-sm text-lg font-bold tracking-tight text-foreground transition-colors duration-200 group-hover/card:text-accent focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:outline-none sm:text-xl"
        style={{
          viewTransitionName: slugifyStr(String(title).replaceAll(".", "-")),
        }}
      >
        <Heading class="line-clamp-2 leading-snug">
          {title}
        </Heading>
        <!-- Expand clickable area to whole card on top of everything, minus the description -->
        <span class="absolute -inset-5 z-10 sm:-inset-6" aria-hidden="true"
        ></span>
      </a>

      <p
        class="pointer-events-auto relative z-20 mt-2.5 line-clamp-2 text-sm leading-relaxed opacity-75 select-text"
      >
        {description}
      </p>
    </div>
  </div>
</li>

<style>
  .card-glow-effect {
    background: radial-gradient(
      400px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      color-mix(in oklab, var(--accent) 12%, transparent) 0%,
      color-mix(in oklab, var(--accent) 8%, transparent) 20%,
      color-mix(in oklab, var(--accent) 4%, transparent) 40%,
      transparent 80%
    );
    transform: translateZ(0);
    will-change: transform;
  }
  .card-noise {
    background-image: url("/noise.png");
    background-repeat: repeat;
    background-size: 64px 64px;
    mix-blend-mode: overlay;
    opacity: 0;
  }
  .group\/card:hover .card-noise {
    opacity: 0.3;
  }
</style>
